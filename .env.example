# ---------------------------------------------------------------------------
# Portfolio chat assistant — environment template.
# Copy to .env.local for local dev, or set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.
# NEVER commit real keys. .env*.local is gitignored.
# ---------------------------------------------------------------------------

# === LLM (chat completions, OpenAI-compatible) =============================
# Production (Vercel) — Google Gemini, free tier:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-flash-latest
#   LLM_API_KEY=<your Google AI Studio key>
#
# Local dev — the 9router gateway on this machine:
#   LLM_BASE_URL=http://127.0.0.1:20128/v1
#   LLM_MODEL=kr/claude-haiku-4.5
#   LLM_API_KEY=<your 9router key>
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=
LLM_MODEL=kr/claude-haiku-4.5
# Optional comma-separated fallbacks if the primary model errors.
LLM_FALLBACKS=kr/claude-sonnet-4.5,kr/auto

# === Embeddings (RAG retrieval) ============================================
# The embedding provider is decided by content/index.json, which is generated
# by `npm run build:kb`. Whichever provider you use there, the matching API key
# must be present at runtime.
#
# Production: build the index with Gemini (needs GEMINI_API_KEY), e.g.
#   EMBED_PROVIDER=gemini npm run build:kb
#   GEMINI_API_KEY=<your Google AI Studio key>   (same key can serve both)
GEMINI_API_KEY=
# Model/dims used when building the index with the Gemini provider.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768

# Local/offline alternative (no cloud key, downloads a model at build time):
#   EMBED_PROVIDER=local npm run build:kb
EMBED_PROVIDER=gemini
LOCAL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# === Optional: allowed origins for the chat API ============================
# Comma-separated. Same-origin requests are always allowed. Add your custom
# domain here if you call the API from another origin.
# ALLOWED_ORIGINS=https://your-domain.com
