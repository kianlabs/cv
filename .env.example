# ---------------------------------------------------------------------------
# Portfolio chat assistant — environment template.
# Copy to .env.local for local dev, or set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.
# NEVER commit real keys. .env*.local is gitignored.
# ---------------------------------------------------------------------------

# === LLM (chat completions, OpenAI-compatible) =============================
# Any OpenAI-compatible endpoint works. Pick ONE of these setups:
#
# (a) Cloudflare Workers AI — simplest for production: ONE provider and ONE
#     token for both chat and embeddings.
#       LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1
#       LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
#       (leave LLM_API_KEY empty — CLOUDFLARE_API_TOKEN is used automatically)
#
# (b) Local 9router gateway — free and unmetered while your PC is on. Use for
#     local dev (no Cloudflare quota consumed).
#       LLM_BASE_URL=http://127.0.0.1:20128/v1
#       LLM_MODEL=ag/gemini-3.8-flash
#       (leave LLM_API_KEY empty — NINE_ROUTER_API_KEY is used automatically)
#
# (c) 9router via a named Cloudflare Tunnel — lets the DEPLOYED site use your
#     local models at a STABLE URL. Set up once:
#       cloudflared tunnel login
#       cloudflared tunnel create 9router
#       cloudflared tunnel route dns 9router llm.kianlabs.my.id
#     then run it as a service:  scripts/tunnel-9router.sh restart
#       LLM_BASE_URL=https://llm.kianlabs.my.id/v1
#     NOTE: only works while your PC and the tunnel are running.
#
# (d) The named tunnel (c) protected by Cloudflare Access — recommended when the
#     hostname is public. Access rejects every request without a valid service
#     token at the edge, before it reaches the gateway. Create one in
#     Zero Trust → Access → Service Auth → Service Tokens, then set:
#       CF_ACCESS_CLIENT_ID=<client id>        (ends in .access)
#       CF_ACCESS_CLIENT_SECRET=<client secret>
#     These are sent as CF-Access-Client-Id / CF-Access-Client-Secret.
LLM_BASE_URL=http://127.0.0.1:20128/v1
# Leave empty to auto-select the right key for LLM_BASE_URL (Cloudflare token
# for api.cloudflare.com, 9router key for every other host).
LLM_API_KEY=
# Optional: only needed when the endpoint sits behind Cloudflare Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
LLM_MODEL=ag/gemini-3.8-flash
# Optional comma-separated fallbacks if the primary model errors.
LLM_FALLBACKS=kr/claude-haiku-4.5,ag/gemini-3.7-flash

# === Embeddings (RAG retrieval) ============================================
# The embedding provider is decided by content/index.json, which is generated
# by `npm run build:kb`. Whichever provider you use there, the matching API key
# must be present at runtime.
#
# Cloudflare Workers AI (recommended): multilingual bge-m3, fast from the edge.
#   EMBED_PROVIDER=cloudflare npm run build:kb
#   CLOUDFLARE_ACCOUNT_ID=<account id>
#   CLOUDFLARE_API_TOKEN=<token with Workers AI : Read>
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-m3
CLOUDFLARE_EMBED_DIMS=1024
#
# Optional cross-encoder rerank (lib/embed.ts). Reorders the top candidates by
# reading query and passage together; falls back to the fused ranking on any
# error, so it is safe to leave on. Enabled automatically whenever the Cloudflare
# credentials above are present — set RERANK_ENABLED=0 to turn it off.
# RERANK_ENABLED=1
# RERANK_MODEL=@cf/baai/bge-reranker-base
#
# Optional: only needed to manage DNS from the CLI (`python3 scripts/dns.py`).
# Needs Zone : DNS : Edit + Zone : Zone : Read. Never commit the real value.
CLOUDFLARE_DNS_TOKEN=
#
# Gemini alternative (needs GEMINI_API_KEY):
#   EMBED_PROVIDER=gemini npm run build:kb
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMS=768

EMBED_PROVIDER=cloudflare

# === Optional: allowed origins for the chat API ============================
# Comma-separated. Same-origin requests are always allowed. Add your custom
# domain here if you call the API from another origin.
# ALLOWED_ORIGINS=https://your-domain.com
